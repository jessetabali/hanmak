# Base URL for the DRF API (no trailing slash)
# Leave empty to use the Vite dev proxy (recommended for local dev)
VITE_API_BASE_URL=

# Set to "true" to auto-login with demo credentials on first load (dev only)
VITE_ALLOW_DEMO_AUTO_LOGIN=false

# Sentry DSN for error tracking (leave empty to disable)
VITE_SENTRY_DSN=
