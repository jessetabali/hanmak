DJANGO_SECRET_KEY=change-me
DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DATABASE_URL=postgres://hanmak:hanmak@postgres:5432/hanmak
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=no-reply@hanmak.local
HANMAK_PUBLIC_BASE_URL=http://localhost:8080
HANMAK_LOGIN_LOCKOUT_FAILURES=5
HANMAK_LOGIN_LOCKOUT_MINUTES=15
HANMAK_EMAIL_BOUNCE_WEBHOOK_SECRET=
SENDGRID_WEBHOOK_PUBLIC_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=
HANMAK_PAYMENT_PROVIDER=mock
HANMAK_PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
STRIPE_WEBHOOK_SECRET=
ADYEN_WEBHOOK_HMAC_KEY=
HANMAK_APM_PROVIDER=otel
HANMAK_ENVIRONMENT=development
HANMAK_RELEASE=dev
HANMAK_APM_SAMPLE_RATE=0.1
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=hanmak-backend
HANMAK_ALERT_WEBHOOK_URL=http://localhost:8080/mock/alerts
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
USE_X_FORWARDED_PROTO=false
HANMAK_PRIMARY_DOMAIN=localhost:8080
HANMAK_TLS_REDIRECT_CONFIGURED=true
STATIC_ROOT=/app/staticfiles
HANMAK_MEDIA_BACKUP_POLICY=
HANMAK_BACKUP_POLICY=dev-postgres-volume-snapshot
HANMAK_LAST_RESTORE_DRILL_AT=2026-05-20T00:00:00Z
HANMAK_SECRETS_MANAGER=docker-env-file
HANMAK_SIGNING_APP_PATH=/mock/
# MinIO / S3 storage — uses Docker-internal endpoint for Django file ops,
# and the host-accessible port for browser downloads via AWS_S3_CUSTOM_DOMAIN.
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio-password
AWS_STORAGE_BUCKET_NAME=hanmak
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_CUSTOM_DOMAIN=localhost:8080/files
AWS_S3_URL_PROTOCOL=http:
AWS_QUERYSTRING_AUTH=false
